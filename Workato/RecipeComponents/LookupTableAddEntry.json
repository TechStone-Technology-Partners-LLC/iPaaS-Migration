{
  "name": "Lookup Table - Add Entry",
  "description": "lookup_table/add_entry action — inserts a new row into a Workato Lookup Table. No external connection needed (provider: lookup_table, account_id: null). Table referenced by zip_name or live ID. Column names match the table schema (col1, col2, etc.).",
  "version": 1,
  "private": true,
  "concurrency": 1,
  "code": {
    "number": 0,
    "provider": "clock",
    "name": "scheduled_event",

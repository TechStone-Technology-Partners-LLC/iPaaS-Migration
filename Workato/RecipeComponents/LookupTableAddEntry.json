                    "control_type": "text",
                    "label": "Name",
                    "name": "col1",
                    "type": "string",
                    "sticky": true
                  },
                  {
                    "control_type": "text",
                    "label": "Amount",
                    "name": "col2",
                    "type": "string",
                    "sticky": true
                  }
                ],
                "type": "object"
              }
            ],
            "extended_input_schema": [
              {
                "hint": "Fill the fields for the new entry",

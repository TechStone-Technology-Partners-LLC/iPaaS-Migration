    "input": {
      "time_unit": "minutes",
      "trigger_every": "5"
    },
    "block": [
      {
        "number": 1,
        "keyword": "try",
        "input": {},
        "block": [
          {
            "number": 2,
            "provider": "lookup_table",
            "name": "add_entry",

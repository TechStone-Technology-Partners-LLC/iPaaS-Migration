                "properties": [
                  {
                    "control_type": "text",
                    "label": "Name",
                    "name": "col1",
                    "type": "string",
                    "sticky": true,
                    "optional": true
                  },
                  {
                    "control_type": "text",
                    "label": "Amount",
                    "name": "col2",
                    "type": "string",
                    "sticky": true,
                    "optional": true
